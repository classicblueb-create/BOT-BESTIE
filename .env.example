# Bestie Bot US — Environment Variables
# Copy this file to .env and fill in your keys

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Channel or group to broadcast scheduled alerts to
# Use @channelname  OR  -100xxxxxxxxxx (numeric ID)
TELEGRAM_CHANNEL=@your_channel_here

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Supabase (watchlist + price alerts; shared with the LINE bot) ─────────────
# Project Settings → API → Project URL / service_role key. Without these the bot
# falls back to watchlist.json, which Render wipes on every deploy.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
